# PORT: Port where the server runs (default: 3000)
PORT=3000

# JWT_SECRET: Secret key used to sign and verify JSON Web Tokens for authentication.
JWT_SECRET="edumanage_jwt_secure_secret_key_change_in_production"

# PGLITE_DATA_DIR: Local directory path for PGlite database files.
# If left empty, or if file locks/permissions fail (e.g., on Windows), it gracefully uses safe persistence / memory fallback.
PGLITE_DATA_DIR="./data/pglite"

# GEMINI_API_KEY: Required for Gemini AI API calls (if used).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"
